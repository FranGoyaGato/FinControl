# FinControl — production environment variables
# Save this file as /opt/fincontrol/.env.production on the VPS (never commit it).

# --- MongoDB (dedicated container `fincontrol-mongo`) ---
MONGO_ROOT_USER=fincontrol_admin
MONGO_ROOT_PASS=REPLACE_WITH_STRONG_PASSWORD_NO_SPECIAL_CHARS
# `mongo` is the service name inside this compose file; that's the DNS backend uses.
MONGO_URL=mongodb://fincontrol_admin:REPLACE_WITH_STRONG_PASSWORD_NO_SPECIAL_CHARS@mongo:27017/?authSource=admin
DB_NAME=fincontrol
# Container name (used by scripts/backup.sh)
MONGO_CONTAINER=fincontrol-mongo

# --- CORS ---
# Frontend + backend live at the same origin (Caddy fronts both), so this only
# matters if you ever hit /api from a different subdomain.
CORS_ORIGINS=https://fran.goyainnova.com

# --- Auth ---
# Generate once with:  openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_HEX

# Seed admin (idempotent: only used the first time; afterwards rotate from
# Settings → Seguridad and it will NOT be overwritten on subsequent starts).
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_START
