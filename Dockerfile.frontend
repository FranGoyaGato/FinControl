# syntax=docker/dockerfile:1.6

# ---- Stage 1: build React ----
FROM node:20-alpine AS build
WORKDIR /app

# The React app calls `${REACT_APP_BACKEND_URL}/api/...`. In production we serve
# the API on the SAME origin as the frontend (Caddy → frontend nginx → /api → backend),
# so leaving this empty makes it a relative path (`/api/...`) — no CORS needed.
ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL

# yarn.lock is optional: the `*` glob matches 0 or 1 files, and we fall back
# to a fresh install if it's missing so the build never breaks on a clean clone.
COPY frontend/package.json ./
COPY frontend/yarn.lock* ./
RUN if [ -f yarn.lock ]; then yarn install --frozen-lockfile; else yarn install; fi

COPY frontend/ ./
RUN yarn build

# ---- Stage 2: nginx runtime ----
FROM nginx:1.27-alpine
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
