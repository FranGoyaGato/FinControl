#!/usr/bin/env bash
# Suite completa: backend (pytest) + frontend (jest), contra un Mongo real en
# Docker. Falla en cuanto algo falla (set -e): nada de "|| true" tapando rojo.
set -euo pipefail
cd "$(dirname "$0")/../.."

echo "== full-suite: levantando mongo =="
docker compose up -d mongo

echo "== full-suite: esperando a que mongo responda =="
listo=0
for _ in $(seq 1 30); do
  if docker compose exec -T mongo mongosh --quiet --eval "db.runCommand('ping')" >/dev/null 2>&1; then
    listo=1
    break
  fi
  sleep 1
done
if [ "$listo" -ne 1 ]; then
  echo "mongo no respondió a tiempo" >&2
  exit 1
fi

echo "== full-suite: backend (pytest) =="
(
  cd backend
  python -m venv .venv
  if [ -f .venv/bin/activate ]; then source .venv/bin/activate; else source .venv/Scripts/activate; fi
  pip install --quiet -r requirements.txt
  MONGO_URL="${MONGO_URL:-mongodb://localhost:27017}" \
    DB_NAME="${DB_NAME:-fincontrol_test}" \
    CORS_ORIGINS="*" \
    python -m pytest tests/ -q
)

echo "== full-suite: frontend (jest) =="
(
  cd frontend
  corepack yarn install --frozen-lockfile
  CI=true corepack yarn test --watchAll=false
)

echo "== full-suite: parando mongo =="
docker compose down

echo "== full-suite: OK =="
